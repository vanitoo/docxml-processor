<?xml version="1.0" encoding="UTF-8"?>
<!-- Проект поставления Правительства РФ "О внесении изменений в постановление Правительства Российской Федерации от 16 февраля 2023 г. № 240" -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:clt_ru="urn:customs.ru:CommonLeafTypes:5.10.0" xmlns:cat_ru="urn:customs.ru:CommonAggregateTypes:5.24.0" xmlns:RUDECLcat="urn:customs.ru:RUDeclCommonAggregateTypesCust:5.28.0" xmlns:cmei="urn:customs.ru:Information:CustomsAuditDocuments:CustomsMonitoringEliminationInfo:5.28.0" targetNamespace="urn:customs.ru:Information:CustomsAuditDocuments:CustomsMonitoringEliminationInfo:5.28.0" elementFormDefault="qualified" attributeFormDefault="unqualified" version="5.28.0.0">
  <xs:import namespace="urn:customs.ru:CommonLeafTypes:5.10.0" schemaLocation="CommonLeafTypesCust.xsd" />
  <xs:import namespace="urn:customs.ru:CommonAggregateTypes:5.24.0" schemaLocation="CommonAggregateTypesCust.xsd" />
  <xs:import namespace="urn:customs.ru:RUDeclCommonAggregateTypesCust:5.28.0" schemaLocation="RUDeclCommonAggregateTypesCust.xsd" />
  <xs:annotation>
    <xs:documentation>Информация участника ВЭД об устранении несоответствий в сведениях из системы учета товаров</xs:documentation>
  </xs:annotation>
  <xs:element name="CustomsMonitoringEliminationInfo" type="cmei:CustomsMonitoringEliminationInfoType">
    <xs:annotation>
      <xs:documentation>Информация участника ВЭД об устранении несоответствий в сведениях из системы учета товаров</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="CustomsMonitoringEliminationInfoType">
    <xs:annotation>
      <xs:documentation>Информация участника ВЭД об устранении несоответствий в сведениях из системы учета товаров</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="cat_ru:BaseDocType">
        <xs:sequence>
          <xs:element name="DocDate" type="clt_ru:DateCustType">
            <xs:annotation>
              <xs:documentation>Дата документа</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="DocNumber" type="clt_ru:DocumentNumberType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Номер документа</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Customs" type="cat_ru:CustomsType">
            <xs:annotation>
              <xs:documentation>Сведения о таможенном органе, принявшем Решение о проведении таможенного мониторинга</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ApplicantInfo" type="RUDECLcat:AEODeclarantDetailsType">
            <xs:annotation>
              <xs:documentation>Сведения о лице, в отношении внешнеэкономической деятельности которого необходимо провести таможенный мониторинг</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="EliminationInfo" type="clt_ru:FreeText250Type" minOccurs="0" maxOccurs="2">
            <xs:annotation>
              <xs:documentation>Информация об устранении нарушений</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ConfirmDoc" type="cmei:ApplicantDocType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Подтверждающий документ</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
        <xs:attribute name="DocumentModeID" type="clt_ru:DocumentModeIDType" use="required" fixed="1006963E">
          <xs:annotation>
            <xs:documentation>Идентификатор вида документа</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:annotation>
    <xs:documentation>Локальные прикладные типы.</xs:documentation>
  </xs:annotation>
  <xs:complexType name="ApplicantDocType">
    <xs:annotation>
      <xs:documentation>Подтверждающие документы</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="cat_ru:DocumentBaseType">
        <xs:sequence>
          <xs:element name="ScanDoc" type="clt_ru:Text3MB" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>Скан документа</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>