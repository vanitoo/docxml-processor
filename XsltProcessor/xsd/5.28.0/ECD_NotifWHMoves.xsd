<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:cat_ru="urn:customs.ru:CommonAggregateTypes:5.24.0" xmlns:clt_ru="urn:customs.ru:CommonLeafTypes:5.10.0" xmlns:RUSclt_ru="urn:customs.ru:RUSCommonLeafTypes:5.21.0" xmlns:RUScat_ru="urn:customs.ru:RUSCommonAggregateTypes:5.24.0" xmlns:ecd_nm="urn:customs.ru:Information:ExchangeDocuments:ECD_NotifWHMoves:5.28.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:customs.ru:Information:ExchangeDocuments:ECD_NotifWHMoves:5.28.0" elementFormDefault="qualified" version="5.28.0.0">
	<xs:import namespace="urn:customs.ru:CommonLeafTypes:5.10.0" schemaLocation="CommonLeafTypesCust.xsd"/>
	<xs:import namespace="urn:customs.ru:CommonAggregateTypes:5.24.0" schemaLocation="CommonAggregateTypesCust.xsd"/>
	<xs:import namespace="urn:customs.ru:RUSCommonLeafTypes:5.21.0" schemaLocation="RUSCommonLeafTypes.xsd"/>
	<xs:import namespace="urn:customs.ru:RUSCommonAggregateTypes:5.24.0" schemaLocation="RUSCommonAggregateTypes.xsd"/>
	<xs:annotation>
		<xs:documentation>Уведомление о вывозе со склада электронной торговли товаров электронной торговли/ Уведомление о возврате на склад электронной торговли товаров электронной торговли</xs:documentation>
	</xs:annotation>
	<xs:element name="ECD_NotifWHMoves" type="ecd_nm:ECD_NotifWHMovesType">
		<xs:annotation>
			<xs:documentation>Уведомление о вывозе со склада электронной торговли товаров электронной торговли/ Уведомление о возврате на склад электронной торговли товаров электронной торговли</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:complexType name="ECD_NotifWHMovesType">
		<xs:annotation>
			<xs:documentation>Уведомление о вывозе со склада электронной торговли товаров электронной торговли/ Уведомление о возврате на склад электронной торговли товаров электронной торговли</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="cat_ru:BaseDocType">
				<xs:sequence>
					<xs:element name="DocKind" type="clt_ru:LetterIndicatorType">
						<xs:annotation>
							<xs:documentation>Вид уведомления: 1 - Уведомление о вывозе со склада электронной торговли товаров электронной торговли ; 2 - Уведомление о возврате на склад электронной торговли товаров электронной торговли</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="NotifNumber" type="ecd_nm:NotifNumberType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Регистрационный номер Уведомления</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Applicant" type="cat_ru:OrganizationBaseType">
						<xs:annotation>
							<xs:documentation>Основные сведения о заявителе</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CloseDate" type="clt_ru:DateCustType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Дата вывоза товаров со склада</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ECD_Number" type="cat_ru:GTDIDType">
						<xs:annotation>
							<xs:documentation>Номер декларации на товары электронной торговли</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Goods" type="ecd_nm:GoodsType">
						<xs:annotation>
							<xs:documentation>Сведения о товарах</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
				<xs:attribute name="DocumentModeID" type="clt_ru:DocumentModeIDType" use="required" fixed="1004169E">
					<xs:annotation>
						<xs:documentation>Идентификатор вида документа</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:annotation>
		<xs:documentation>Локальные прикладные типы</xs:documentation>
	</xs:annotation>
	<xs:complexType name="GoodsType">
		<xs:annotation>
			<xs:documentation>Сведения о товарах</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="GoodsNumber" type="clt_ru:Count5Type">
				<xs:annotation>
					<xs:documentation>Номер товара</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ShipmentNumber" type="clt_ru:Text50Type">
				<xs:annotation>
					<xs:documentation>Номер отправления
(индивидуальной накладной)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GoodsDescription" type="RUSclt_ru:FreeText1000Type">
				<xs:annotation>
					<xs:documentation>Наименование товара</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GoodsNomenclatuerCode" type="clt_ru:CUGoodsNomenclatuerCodeType">
				<xs:annotation>
					<xs:documentation>Код товара в соответствии с Единой товарной номенклатурой внешнеэкономической деятельности </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SupplementaryQuantity" type="cat_ru:SupplementaryQuantityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Количество товара в дополнительной единице измерения</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ContractCost" type="RUScat_ru:AmountType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Стоимость, 
валюта покупки</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GoodsNetWeight" type="clt_ru:QuantityBasisType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Вес нетто товара кг</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GoodsGrossWeight" type="clt_ru:QuantityBasisType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Вес брутто товара, кг</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Documents" type="RUScat_ru:DocBaseV2Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Сведения о документах, подтверждающих соблюдение запретов и ограничений</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NotifNumber" type="ecd_nm:NotifNumberType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Регистрационный номер Уведомления о вывозе</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="NotifNumberType">
		<xs:annotation>
			<xs:documentation>Регистрационный номер Уведомления</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="cat_ru:GTDIDType">
				<xs:sequence>
					<xs:element name="AddNumber" type="clt_ru:Code3Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Дополнительная часть номера</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
</xs:schema>
