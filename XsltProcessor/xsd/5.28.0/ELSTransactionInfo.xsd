<?xml version="1.0" encoding="UTF-8"?>
<!--Проект приказа вместо Приказа ФТС России от 25 февраля 2019 г. № 321 «Об утверждении форм заявления лица, внесшего авансовые платежи, о предоставлении отчета о расходовании денежных средств, внесенных в качестве авансовых платежей, отчета о расходовании денежных средств, внесенных в качестве авансовых платежей, порядка подачи лицом, внесшим авансовые платежи, заявления о предоставлении отчета о расходовании денежных средств, внесенных в качестве авансовых платежей, а также порядка предоставления таможенным органом такого отчета»-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:clt_ru="urn:customs.ru:CommonLeafTypes:5.10.0" xmlns:cat_ru="urn:customs.ru:CommonAggregateTypes:5.24.0" xmlns:cat_crd="urn:customs.ru:CardCommonAggregateTypes:5.21.0" xmlns:RUScat_ru="urn:customs.ru:RUSCommonAggregateTypes:5.24.0" xmlns:trinf="urn:customs.ru:Information:ELSDocuments:ELSTransactionInfo:5.28.0" xmlns:els_agr="urn:customs.ru:Information:ELSDocuments:ELSAggregateTypes:5.27.0" targetNamespace="urn:customs.ru:Information:ELSDocuments:ELSTransactionInfo:5.28.0" elementFormDefault="qualified" version="5.28.0.0">
	<xs:import namespace="urn:customs.ru:CommonLeafTypes:5.10.0" schemaLocation="CommonLeafTypesCust.xsd"/>
	<xs:import namespace="urn:customs.ru:CommonAggregateTypes:5.24.0" schemaLocation="CommonAggregateTypesCust.xsd"/>
	<xs:import namespace="urn:customs.ru:CardCommonAggregateTypes:5.21.0" schemaLocation="CardCommonAggregateTypes.xsd"/>
	<xs:import namespace="urn:customs.ru:Information:ELSDocuments:ELSAggregateTypes:5.27.0" schemaLocation="ELSAggregateTypes.xsd"/>
	<xs:import namespace="urn:customs.ru:RUSCommonAggregateTypes:5.24.0" schemaLocation="RUSCommonAggregateTypes.xsd"/>
	<xs:annotation>
		<xs:documentation>Отчет о расходовании денежных средств, внесенных в качестве авансовых платежей</xs:documentation>
	</xs:annotation>
	<xs:element name="ELSTransactionInfo" type="trinf:ELSTransactionInfoType">
		<xs:annotation>
			<xs:documentation>Отчет о расходовании денежных средств, внесенных в качестве авансовых платежей</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:complexType name="ELSTransactionInfoType">
		<xs:annotation>
			<xs:documentation>Отчет о расходовании денежных средств, внесенных в качестве авансовых платежей</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="cat_crd:BaseDocType">
				<xs:sequence>
					<xs:element name="ApplicantInfo" type="trinf:DeclarantInfoExtType">
						<xs:annotation>
							<xs:documentation>Сведения о заявителе</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PeriodBegin" type="clt_ru:DateCustType">
						<xs:annotation>
							<xs:documentation>Начало запрашиваемого периода</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PeriodEnd" type="clt_ru:DateCustType">
						<xs:annotation>
							<xs:documentation>Окончание запрашиваемого периода</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ReportDate" type="clt_ru:DateCustType">
						<xs:annotation>
							<xs:documentation>Дата отчета</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ReportType" type="clt_ru:IndicatorType">
						<xs:annotation>
							<xs:documentation>0 - отчет по запросу; 1 - отчет по заявлению</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ELSConfInfoApp" type="cat_ru:DocumentBaseType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Заявление лица, внесшего авансовые платежи, о предоставлении отчета о расходовании денежных средств, внесенных в качестве авансовых платежей</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="BalanceIn" type="clt_ru:AmountType">
						<xs:annotation>
							<xs:documentation>Входящий остаток денежных средств</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="BalanceOut" type="clt_ru:AmountType">
						<xs:annotation>
							<xs:documentation>Исходящий остаток денежных средств</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PaymentInformation" type="trinf:PaymentInformationType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Сведения о платеже</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TotalPayAmountReceipt" type="clt_ru:AmountType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Итоговая сумма поступлений по сведениям о платеже</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TotalPayAmountChargeOff" type="clt_ru:AmountType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Итоговая сумма списаний по сведениям о платеже</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CustomsDetails" type="cat_ru:CustomsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Сведения о таможенном органе, сформировавшем отчет</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CustomSignature" type="cat_ru:PersonSignatureType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Уполномоченное должностное лицо
таможенного органа</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
				<xs:attribute name="DocumentModeID" type="clt_ru:DocumentModeIDType" use="required" fixed="1040024E">
					<xs:annotation>
						<xs:documentation>Идентификатор вида документа</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:annotation>
		<xs:documentation>Локальные прикладные типы.</xs:documentation>
	</xs:annotation>
	<xs:complexType name="DeclarantInfoExtType">
		<xs:annotation>
			<xs:documentation>Информация о заявителе</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="RUScat_ru:RUOrganizationBaseType">
				<xs:sequence>
					<xs:element name="OKPOID" type="clt_ru:OKPOIDType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Код организации по ОКПО</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OKATOCode" type="clt_ru:OKATOCodeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Код ОКАТО</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Address" type="RUScat_ru:RUAddressType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Адрес (почтовый адрес) </xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Contact" type="cat_ru:ContactType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Контактная информация</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="FactAddress" type="RUScat_ru:RUAddressType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Фактический адрес заявителя</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="InsuranceNumber" type="clt_ru:CodeVariable11Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Страховой номер индивидуального лицевого счёта (СНИЛС)</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="BornDate" type="clt_ru:DateCustType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Дата рождения физического лица</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="IdentityCard" type="RUScat_ru:RUIdentityCardType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Документ, удостоверяющий личность физического лица</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TaxNumber" type="RUScat_ru:UITN40Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Налоговый номер (или его аналог), для лиц, не состоящих на учете в налоговых органах РФ</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DocumentType">
		<xs:annotation>
			<xs:documentation>Сведения о документе</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="RUScat_ru:DocBaseV4Type">
				<xs:sequence>
					<xs:element name="PrDocumentCustomCode" type="clt_ru:CustomsCodeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Код таможенного органа</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PaymentInformationType">
		<xs:annotation>
			<xs:documentation>Сведения о платеже</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OperationNumber" type="clt_ru:Count5Type">
				<xs:annotation>
					<xs:documentation>Порядковый номер операции</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OperationType" type="clt_ru:IndicatorType">
				<xs:annotation>
					<xs:documentation>Тип операции. 1 - поступление, 0 - списание</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OperationDate" type="clt_ru:DateCustType">
				<xs:annotation>
					<xs:documentation>Дата операции</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DocumentReq" type="trinf:DocumentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Реквизиты документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DocumentAmount" type="els_agr:ELSAmountType">
				<xs:annotation>
					<xs:documentation>Сумма операции с денежными средствами</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
