<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:CategoryCust="urn:customs.ru:Categories:3.0.0" xmlns:clt_ru="urn:customs.ru:CommonLeafTypes:5.10.0" xmlns:cat_ru="urn:customs.ru:CommonAggregateTypes:5.24.0" xmlns:RUSclt_ru="urn:customs.ru:RUSCommonLeafTypes:5.21.0" xmlns:RUScat_ru="urn:customs.ru:RUSCommonAggregateTypes:5.24.0" xmlns:catESAD_cu="urn:customs.ru:CUESADCommonAggregateTypesCust:5.28.0" xmlns:ecd_or="urn:customs.ru:Information:CustomsDocuments:ECD_AppOperatorsRegister:5.28.0" targetNamespace="urn:customs.ru:Information:CustomsDocuments:ECD_AppOperatorsRegister:5.28.0" elementFormDefault="qualified" version="5.28.0.0">
  <xs:import namespace="urn:customs.ru:Categories:3.0.0" schemaLocation="CategoriesCust.xsd" />
  <xs:import namespace="urn:customs.ru:CommonLeafTypes:5.10.0" schemaLocation="CommonLeafTypesCust.xsd" />
  <xs:import namespace="urn:customs.ru:CommonAggregateTypes:5.24.0" schemaLocation="CommonAggregateTypesCust.xsd" />
  <xs:import namespace="urn:customs.ru:RUSCommonLeafTypes:5.21.0" schemaLocation="RUSCommonLeafTypes.xsd" />
  <xs:import namespace="urn:customs.ru:RUSCommonAggregateTypes:5.24.0" schemaLocation="RUSCommonAggregateTypes.xsd" />
  <xs:import namespace="urn:customs.ru:CUESADCommonAggregateTypesCust:5.28.0" schemaLocation="CUESADCommonAggregateTypesCust.xsd" />
  <xs:annotation>
    <xs:documentation>Заявление по ведению реестра операторов электронной торговли</xs:documentation>
  </xs:annotation>
  <xs:element name="ECD_AppOperatorsRegister" type="ecd_or:ECD_AppOperatorsRegisterType">
    <xs:annotation>
      <xs:documentation>Заявление по ведению реестра операторов электронной торговли</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="ECD_AppOperatorsRegisterType">
    <xs:annotation>
      <xs:documentation>Заявление по ведению реестра операторов электронной торговли</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="cat_ru:BaseDocType">
        <xs:sequence>
          <xs:element name="DocKind" type="clt_ru:LetterIndicatorType">
            <xs:annotation>
              <xs:documentation>Вид заявления: 1 - о включении в реестр операторов электронной торговли ; 2 - о внесении изменений в реестр операторов электронной торговли; 3 - об исключении из реестра операторов электронной торговли</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Applicant" type="ecd_or:ApplicantType">
            <xs:annotation>
              <xs:documentation>Основные сведения о заявителе</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="AppDate" type="clt_ru:DateCustType">
            <xs:annotation>
              <xs:documentation>Дата заявления</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="CustomsPerson" type="cat_ru:PersonBaseType">
            <xs:annotation>
              <xs:documentation>Должностное лицо таможенного органа, которому направляется заявление</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:choice>
            <xs:element name="RegistryInclusion" type="ecd_or:RegistryInclusionType">
              <xs:annotation>
                <xs:documentation>Включение лица в реестр операторов электронной торговли</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="RegistryAlteration" type="ecd_or:RegistryAlterationType">
              <xs:annotation>
                <xs:documentation>Внесение изменений в реестр операторов электронной торговли</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:choice>
          <xs:element name="AppliedDocument" type="ecd_or:AppliedDocumentType" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>Прилагаемые документы</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="SheetsNumber" type="clt_ru:Count3Type" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Общее количество листов  </xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="HeadPerson" type="cat_ru:PersonBaseType">
            <xs:annotation>
              <xs:documentation>Руководитель организации (представитель по доверенности)</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
        <xs:attribute name="DocumentModeID" type="clt_ru:DocumentIDType" use="required" fixed="1001312E">
          <xs:annotation>
            <xs:documentation>Идентификатор вида документа</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:annotation>
    <xs:documentation>Локальные прикладные  типы</xs:documentation>
  </xs:annotation>
  <xs:complexType name="ApplicantType">
    <xs:annotation>
      <xs:documentation>Основные сведения о заявителе</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="RUScat_ru:OrganizationType">
        <xs:sequence>
          <xs:element name="InformationSourceName" type="clt_ru:FreeText500Type" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Наименование сайта в информационно-телекоммуникационной сети «Интернет»</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="DetailsResourceId" type="RUSclt_ru:String2048Type" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Ссылка на сайт в сети «Интернет»</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="AppliedDocumentType">
    <xs:annotation>
      <xs:documentation>Прилагаемый документ</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="cat_ru:DocumentBaseType">
        <xs:sequence>
          <xs:element name="Sheets" type="clt_ru:Count5Type">
            <xs:annotation>
              <xs:documentation>Количество листов документа</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="PresentedDocId" type="catESAD_cu:RFBasePresentedDocIDType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Технологические идентификаторы представленного документа</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="BankGuaranteeInfoType">
    <xs:annotation>
      <xs:documentation>Реквизиты банковской гарантии</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="DocDate" type="clt_ru:DateCustType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Дата выдачи банковской гарантии</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DocNumber" type="clt_ru:DocumentNumberType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Номер банковской гарантии</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="CashDepositInfoType">
    <xs:annotation>
      <xs:documentation>Реквизиты денежного залога</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="DocDate" type="clt_ru:DateCustType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Дата платежного поручения</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DocNumber" type="clt_ru:CodeVariable6Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Номер</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ContractOfGuaranteeInfoType">
    <xs:annotation>
      <xs:documentation>Реквизиты договора поручительства</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="DocDate" type="clt_ru:DateCustType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Дата заключения договора поручительства</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DocNumber" type="ecd_or:String256Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Номер договора поручительства</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="CustomsReceiptRegNumberType">
    <xs:annotation>
      <xs:documentation>Регистрационный номер таможенной расписки</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="cat_ru:GTDIDType">
        <xs:sequence>
          <xs:element name="DocNumberPrefix" type="clt_ru:Code2Type">
            <xs:annotation>
              <xs:documentation>Префикс порядкового номера таможенной расписки</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="InformationAboutSecuringType">
    <xs:annotation>
      <xs:documentation>Сведения об обеспечении уплаты таможенных пошлин, налогов</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="SupportSum" type="clt_ru:CodeVariable20Type">
        <xs:annotation>
          <xs:documentation>Общая сумма обеспечения исполнения обязанностей юридического лица, осуществляющего деятельность 
в качестве оператора электронной торговли
</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Support" type="ecd_or:SupportType" maxOccurs="10">
        <xs:annotation>
          <xs:documentation>Подтверждение предоставления обеспечения</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="PhysicalPersonType">
    <xs:annotation>
      <xs:documentation>Данные о физлице</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="PersonFIO" type="cat_ru:PersonBaseType">
        <xs:annotation>
          <xs:documentation>ФИО и должность физлица</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="BirthDate" type="clt_ru:DateCustType">
        <xs:annotation>
          <xs:documentation>Дата рождения физлица</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="BirthPlace" type="clt_ru:FreeText250Type">
        <xs:annotation>
          <xs:documentation>Место рождения физлица</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Address" type="RUScat_ru:RUAddressType">
        <xs:annotation>
          <xs:documentation>Место жительства</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="INN" type="clt_ru:Code14Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>СНИЛС физлица</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RegistryAlterationType">
    <xs:annotation>
      <xs:documentation>Процедура внесения изменений в реестр таможенных представителей</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Base" type="clt_ru:FreeText500Type" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Суть обращения</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ChangeInfo" type="RUSclt_ru:FreeText4000Type">
        <xs:annotation>
          <xs:documentation>Сведения, подлежащие изменению</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RegistryInclusionType">
    <xs:annotation>
      <xs:documentation>Включение лица в реестр операторов электронной торговли</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Founder" type="ecd_or:PhysicalPersonType" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Сведения о физических лицах, являющихся учредителем (участником) юридического лица – заявителя, его руководителем, главным бухгалтером</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ParticipantID" type="clt_ru:DocumentIDType">
        <xs:annotation>
          <xs:documentation>Идентификатор информационной системы декларанта 
или оператора информационных услуг </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="BankAccountInformation" type="cat_ru:BankInformationType" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Сведения о банковских счетах</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="WHInformation" type="ecd_or:WHInformationType">
        <xs:annotation>
          <xs:documentation>Сведения о складе электронной торговли</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="InformationAboutSecuring" type="ecd_or:InformationAboutSecuringType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Сведения об обеспечении уплаты таможенных пошлин, налогов</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="RiskInsurance" type="ecd_or:RiskInsuranceType">
        <xs:annotation>
          <xs:documentation>Сведения о договоре страхования риска гражданской ответственности</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RiskInsuranceType">
    <xs:annotation>
      <xs:documentation>Сведения о договоре страхования риска гражданской ответственности</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="PriceInsurance" type="clt_ru:AmountType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Общая сумма страхования</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="NumInsurance" type="clt_ru:FreeText250Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Номер договора</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DateInsurance" type="clt_ru:DateCustType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Дата договора</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DateOnInsurance" type="clt_ru:DateCustType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Срок действия с</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DateOffInsurance" type="clt_ru:DateCustType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Срок действия по</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="InsuranceCompanyName" type="clt_ru:FreeText250Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Наименование страховой компании</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="LiabilityInsurance" type="cat_ru:DocumentBaseType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Лицензия на право страхования ответственности</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="SupportType">
    <xs:annotation>
      <xs:documentation>Подтверждение предоставления обеспечения</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="TypeSupport" type="clt_ru:CodeVariable2Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Код способа обеспечения (01-Денежный залог, 02 - Банковская гарантия, 03 - Договор поручительства)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:choice>
        <xs:element name="BankGuaranteeInfo" type="ecd_or:BankGuaranteeInfoType">
          <xs:annotation>
            <xs:documentation>Реквизиты банковской гарантии</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="CashDepositInfo" type="ecd_or:CashDepositInfoType">
          <xs:annotation>
            <xs:documentation>Реквизиты денежного залога</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ContractOfGuaranteeInfo" type="ecd_or:ContractOfGuaranteeInfoType">
          <xs:annotation>
            <xs:documentation>Реквизиты договора поручительства</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:choice>
      <xs:element name="TypeSupportSum" type="clt_ru:AmountType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Сумма</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="TypeSupportCurrency" type="clt_ru:CurrencyA3CodeType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Валюта</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SupportWith" type="clt_ru:DateCustType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Срок действия с</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SupportPeriod" type="clt_ru:DateCustType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Срок действия до</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="GuaranteeCustomsReceiptNum" type="ecd_or:CustomsReceiptRegNumberType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Номер таможенной расписки</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="WHInformationType">
    <xs:annotation>
      <xs:documentation>Сведения о складе электронной торговли</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="WHPurpose" type="clt_ru:LetterIndicatorType" maxOccurs="2">
        <xs:annotation>
          <xs:documentation>Назначение склада электронной торговли: 1 - временное хранение товаров электронной торговли; 2 - хранение товаров электронной торговли, помещенных под таможенную процедуру таможенного склада</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="WHPurposeAddress" type="RUScat_ru:RUAddressType">
        <xs:annotation>
          <xs:documentation>Адрес склада электронной торговли</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="WHArrangement" type="RUSclt_ru:FreeText4000Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Обустройство, оборудование и материально-техническое оснащение склада электронной торговли</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="WHUsefulVolume" type="clt_ru:QuantityBasisType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Полезный объем склада электронной торговли</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="WHUsableArea" type="clt_ru:QuantityBasisType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Полезная площадь склада электронной торговли</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="String256Type">
    <xs:annotation>
      <xs:documentation>Текст от 1 до 256 символов</xs:documentation>
    </xs:annotation>
    <xs:restriction base="CategoryCust:CodeCategoriesCust">
      <xs:minLength value="1" />
      <xs:maxLength value="256" />
    </xs:restriction>
  </xs:simpleType>
</xs:schema>