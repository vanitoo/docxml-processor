<?xml version="1.0" encoding="UTF-8"?>
<!-- Проект приказа Минфина России «Об определении Порядка перевозки товаров, пересылаемых в международных почтовых отправлениях, от места их ввоза (прибытия) до отдельного помещения в месте международного почтового обмена, являющегося местом временного хранения товаров, расположенным не в месте ввоза (прибытия), с применением таможенного наблюдения без помещения этих товаров под таможенную процедуру таможенного транзита» -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:clt_ru="urn:customs.ru:CommonLeafTypes:5.10.0" xmlns:cat_ru="urn:customs.ru:CommonAggregateTypes:5.24.0" xmlns:mpoea="urn:customs.ru:Information:CustomsDocuments:MailManifest:5.28.0" targetNamespace="urn:customs.ru:Information:CustomsDocuments:MailManifest:5.28.0" elementFormDefault="qualified" version="5.28.0.0">
	<xs:import namespace="urn:customs.ru:CommonLeafTypes:5.10.0" schemaLocation="CommonLeafTypesCust.xsd"/>
	<xs:import namespace="urn:customs.ru:CommonAggregateTypes:5.24.0" schemaLocation="CommonAggregateTypesCust.xsd"/>
	<xs:annotation>
		<xs:documentation>Почтовый манифест (авиа)</xs:documentation>
	</xs:annotation>
	<xs:element name="MailManifest" type="mpoea:MailManifestType">
		<xs:annotation>
			<xs:documentation>Почтовый манифест (авиа)</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:complexType name="MailManifestType">
		<xs:annotation>
			<xs:documentation>Почтовый манифест (авиа)</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="cat_ru:BaseDocType">
				<xs:sequence>
					<xs:element name="Reestr_ID" type="clt_ru:Text50Type">
						<xs:annotation>
							<xs:documentation>Номер рейса</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ArrivalDateTime" type="clt_ru:DateTimeCustType">
						<xs:annotation>
							<xs:documentation>Дата и время прилета</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DeparturePoint" type="clt_ru:Text150Type">
						<xs:annotation>
							<xs:documentation>Пункт вылета</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="UnloadingPoint" type="clt_ru:Text150Type">
						<xs:annotation>
							<xs:documentation>Пункт выгрузки</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AircraftTypet" type="clt_ru:Text150Type">
						<xs:annotation>
							<xs:documentation>Тип ВС</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="FlightNumber" type="clt_ru:Text50Type">
						<xs:annotation>
							<xs:documentation>Номер борта</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TotalPlaces" type="clt_ru:Count5Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Общее количество почты (мест)</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TotalWeight" type="clt_ru:QuantityBasis0Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Общее количество почты (вес в кг)</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ULD_Numbers" type="clt_ru:Text50Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Номера ULD с почтой</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Loader" type="mpoea:SubjectType">
						<xs:annotation>
							<xs:documentation>Сведения о выгрузке</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MalfunctionSign" type="clt_ru:IndicatorType">
						<xs:annotation>
							<xs:documentation>Признак наличия неисправностей при перевозке почты: 1 - неисправности обнаружены; 0 - неисправности отсутствуют</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CustomsMarks" type="clt_ru:FreeText500Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Отметки таможенного органа</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CompletedDocPerson" type="mpoea:SubjectType">
						<xs:annotation>
							<xs:documentation>Сведения о лице, заполнившем документ </xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
				<xs:attribute name="DocumentModeID" type="clt_ru:DocumentModeIDType" use="required" fixed="1006385E">
					<xs:annotation>
						<xs:documentation>Идентификатор вида документа</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:annotation>
		<xs:documentation>Локальные прикладные типы</xs:documentation>
	</xs:annotation>
	<xs:complexType name="SubjectType">
		<xs:annotation>
			<xs:documentation>Сведения о грузчике</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OrganizationName" type="clt_ru:NameType">
				<xs:annotation>
					<xs:documentation>Наименование организации</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Person" type="cat_ru:PersonBaseType">
				<xs:annotation>
					<xs:documentation>ФИО и должность исполнителя</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
