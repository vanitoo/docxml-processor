<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:cat_ru="urn:customs.ru:CommonAggregateTypes:5.24.0" xmlns:clt_ru="urn:customs.ru:CommonLeafTypes:5.10.0" xmlns:catpi_ru="urn:customs.ru:Information:PriorInformation:PriorCommonAggregateTypes:5.28.0" xmlns:aap="urn:customs.ru:Information:CustomsDocuments:AddAutoPreliminary:5.28.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:customs.ru:Information:CustomsDocuments:AddAutoPreliminary:5.28.0" elementFormDefault="qualified" version="5.28.0.0">
  <xs:import namespace="urn:customs.ru:CommonAggregateTypes:5.24.0" schemaLocation="CommonAggregateTypesCust.xsd" />
  <xs:import namespace="urn:customs.ru:CommonLeafTypes:5.10.0" schemaLocation="CommonLeafTypesCust.xsd" />
  <xs:import namespace="urn:customs.ru:Information:PriorInformation:PriorCommonAggregateTypes:5.28.0" schemaLocation="PriorCommonAggregateTypesCust.xsd" />
  <xs:annotation>
    <xs:documentation>Дополнительные сведения к предварительной информации о товарах, предполагаемых к ввозу на таможенную территорию Евразийского экономического союза автомобильным транспортом</xs:documentation>
  </xs:annotation>
  <xs:element name="AddAutoPreliminary" type="aap:AddAutoPreliminaryType">
    <xs:annotation>
      <xs:documentation>Дополнительные сведения к предварительной информации о товарах, предполагаемых к ввозу на таможенную территорию Евразийского экономического союза автомобильным транспортом</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="AddAutoPreliminaryType">
    <xs:annotation>
      <xs:documentation>Дополнительные сведения к предварительной информации о товарах, предполагаемых к ввозу на таможенную территорию Евразийского экономического союза автомобильным транспортом</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="cat_ru:BaseDocType">
        <xs:sequence>
          <xs:element name="GTDPerson" type="aap:GtdPersonType">
            <xs:annotation>
              <xs:documentation>Сведения о лице, подающем документ(ы)</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="DepartureOprNum" type="clt_ru:Text50Type" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Номер операции, который был оформлен при убытии для РФ перевозчика (Временный вывоз)</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="TransportMeansItemDetails" type="aap:TransportMeansItemDetailsType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Сведения о транспортном средстве в ПИ</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="TransportMeansDetails" type="aap:TransportMeansItemDetailsType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Сведения о транспортном средстве в ТД</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="TransportControl" type="aap:TransportControlType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Сведения для транспортного контроля</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="DocumentControl" type="aap:DocumentControlType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Сведения для документального контроля</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Goods" type="aap:GoodsType" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>Сведения о товарах</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="InventDocument" type="aap:InventDocumentType" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>Прилагаемые документы</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
        <xs:attribute name="DocumentModeID" type="clt_ru:DocumentIDType" use="required" fixed="1006833E">
          <xs:annotation>
            <xs:documentation>Идентификатор вида документа</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:annotation>
    <xs:documentation>Локальные прикладные типы.</xs:documentation>
  </xs:annotation>
  <xs:complexType name="CargoTransportationPermitType">
    <xs:annotation>
      <xs:documentation>Сведения о разрешении на осуществление перевозки грузов</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="cat_ru:DocumentBaseType">
        <xs:sequence>
          <xs:element name="PermitType" type="clt_ru:FreeText250Type" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>Вид разрешения</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="DocValidityDate" type="clt_ru:DateCustType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Дата окончания действия</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="DocumentControlType">
    <xs:annotation>
      <xs:documentation>Сведения для документального контроля</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="DrivingLicense" type="cat_ru:DocumentBaseType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Водительское удостоверение</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="VehicleRegCertificate" type="cat_ru:DocumentBaseType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Свидетельство о регистрации транспортного средства</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="TransportationType" type="clt_ru:FreeText250Type" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Вид перевозки</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="TripType" type="clt_ru:FreeText250Type" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Вид поездки</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="CargoTransportationType" type="clt_ru:FreeText250Type" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Вид грузоперевозки</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="CargoTransportationPermit" type="aap:CargoTransportationPermitType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Сведения о разрешении на осуществление перевозки грузов</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="GoodsType">
    <xs:annotation>
      <xs:documentation>Сведения о товаре</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="GoodsNumeric" type="clt_ru:Count3Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Порядковый номер товара</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PakageNumber" type="clt_ru:Text40Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Номер грузового места</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="VeterinaryControl" type="aap:VeterinaryControlType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Сведения для ветеринарного контроля</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SanitaryQuarantineControl" type="aap:SanitaryQuarantineControlType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Сведения для санитарно-карантинного контроля</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="GtdPersonType">
    <xs:annotation>
      <xs:documentation>Сведения о лице, подающем документ(ы)</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="cat_ru:OrganizationBaseType">
        <xs:sequence>
          <xs:element name="BranchOrganizationName" type="clt_ru:NameType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Наименование обособленного подразделения.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="InventDocumentType">
    <xs:annotation>
      <xs:documentation>Документ из описи</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="InvDocCode" type="clt_ru:CustomsDocumentCodeType">
        <xs:annotation>
          <xs:documentation>Код вида представляемого документа. Заполняется согласно Классификатору видов документов, используемых при заявлении сведений в графе 44 ДТ. </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="InvDocName" type="clt_ru:DocumentNameType">
        <xs:annotation>
          <xs:documentation>Вид документа</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="InvDocNumber" type="clt_ru:DocumentNumberType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Номер документа</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="InvDocDate" type="clt_ru:DateCustType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Дата документа</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="InvDocLists" type="clt_ru:SheetNumberType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Количество листов в документе</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="InvDocCopies" type="clt_ru:Count3Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Количество экземпляров</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Note" type="clt_ru:FreeText250Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Примечание</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ArchID" type="clt_ru:DocumentIDType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Идентификатор электронного архива декларанта</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ArchDocID" type="clt_ru:DocumentIDType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Идентификатор документа в электронном архиве декларанта</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="InventDocumentID" type="clt_ru:DocumentIDType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Уникальный идентификатор документа, представленного в описи. Заполняется при использовании в системах электронного декларирования в случае наличия на момент составления описи указанного документа в электронном виде.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="InventLineID" type="clt_ru:DocumentIDType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Уникальный идентификатор строки в описи. GUID. Обязателен для заполнения при использовании в системах электронного декларирования.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DocumentFormSign" type="clt_ru:DigitalIndicatorType">
        <xs:annotation>
          <xs:documentation>Признак формы представления документа. 0 - в электронной форме, 1 - в виде бумажного документа</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Reason" type="clt_ru:FreeText250Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Причины, по которым невозможно предоставить документ</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SerialNumber" type="clt_ru:Count3Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Порядковый номер ЭПДТ в последовательности ЭПДТ, подаваемых на одну ЭВДТ</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SerialNumberSign" type="clt_ru:IndicatorType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Признак того, что данный документ (ЭПДТ) является последним в последовательности</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="SanitaryQuarantineControlType">
    <xs:annotation>
      <xs:documentation>Сведения для санитарно-карантинного контроля</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="GoodsUse" type="clt_ru:FreeText250Type" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Область применения товара</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="FoodGoods" type="clt_ru:FreeText250Type" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Характеристика пищевых продуктов</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PromGoods" type="clt_ru:FreeText250Type" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Характеристика промышленных товаров</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="TransportControlType">
    <xs:annotation>
      <xs:documentation>Сведения для транспортного контроля</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="IsothermalBody" type="clt_ru:IndicatorType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Изотермический кузов</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PinCount" type="clt_ru:Count3Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Количество осей транспортного средства</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="WheelQuantity" type="clt_ru:Count2Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Количество колес транспортного средства по осям</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="TransportMeansItemDetailsType">
    <xs:annotation>
      <xs:documentation>Сведения о транспортном средстве</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="TrailerAvailability" type="clt_ru:IndicatorType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Наличие прицепа</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="TrailerNumber" type="clt_ru:TransportMeansIDType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Номер прицепа</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="TrailerType" type="clt_ru:TransportNameType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Вид прицепа</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="RegistrationCountry" type="clt_ru:CountryNameType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Страна регистрации транспортного средства</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Mark" type="clt_ru:TransportNameType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Марка транспортного средства</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ControlledItemsDetails" type="catpi_ru:ControlledItemsDetailsType" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Сведения о наличии на транспортном средстве запасных частей или оборудования для ремонта</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="VeterinaryControlType">
    <xs:annotation>
      <xs:documentation>Сведения для ветеринарного контроля</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="IDNumber" type="clt_ru:DocumentIDType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Номер идентификатора, полученного в Россельхознадзоре</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>