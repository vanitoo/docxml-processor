<?xml version="1.0" encoding="UTF-8"?>
<!-- Проект постановления Правительства РФ "О внесении изменений в постановление Правительства Российской Федерации от 16 февраля 2023 г. № 240" -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:clt_ru="urn:customs.ru:CommonLeafTypes:5.10.0" xmlns:cat_ru="urn:customs.ru:CommonAggregateTypes:5.24.0" xmlns:RUDECLcat="urn:customs.ru:RUDeclCommonAggregateTypesCust:5.28.0" xmlns:pe_res="urn:customs.ru:CustomsAuditDocuments:PartExpResult:5.28.0" targetNamespace="urn:customs.ru:CustomsAuditDocuments:PartExpResult:5.28.0" elementFormDefault="qualified" version="5.28.0.0">
  <xs:import namespace="urn:customs.ru:CommonLeafTypes:5.10.0" schemaLocation="CommonLeafTypesCust.xsd" />
  <xs:import namespace="urn:customs.ru:CommonAggregateTypes:5.24.0" schemaLocation="CommonAggregateTypesCust.xsd" />
  <xs:import namespace="urn:customs.ru:RUDeclCommonAggregateTypesCust:5.28.0" schemaLocation="RUDeclCommonAggregateTypesCust.xsd" />
  <xs:annotation>
    <xs:documentation>Результаты рассмотрения подконтрольным лицом заключения по результатам таможенного мониторинга</xs:documentation>
  </xs:annotation>
  <xs:element name="PartExpResult" type="pe_res:PartExpResultType">
    <xs:annotation>
      <xs:documentation>Результаты рассмотрения подконтрольным лицом заключения по результатам таможенного мониторинга</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="PartExpResultType">
    <xs:annotation>
      <xs:documentation>Результаты рассмотрения подконтрольным лицом заключения по результатам таможенного мониторинга</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="cat_ru:BaseDocType">
        <xs:sequence>
          <xs:element name="Customs" type="cat_ru:CustomsType" minOccurs="1">
            <xs:annotation>
              <xs:documentation>Сведения о таможенном органе, в адрес которого направляются Результаты и которым составлено Заключение по результатам таможенного мониторинга</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="DocNumber" type="pe_res:DocResNumberType" minOccurs="1">
            <xs:annotation>
              <xs:documentation>Номер документа</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="DocDate" type="clt_ru:DateCustType" minOccurs="1">
            <xs:annotation>
              <xs:documentation>Дата документа</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ConclusionNum" type="pe_res:DocConcNumberType" minOccurs="1">
            <xs:annotation>
              <xs:documentation>Сведения о номере Заключения</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ApplicantInfo" type="RUDECLcat:AEODeclarantDetailsType" minOccurs="1">
            <xs:annotation>
              <xs:documentation>Сведения о лице, в отношении которого проведен таможенный мониторинг и которым представлены Результаты</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ResultSign" type="clt_ru:LetterIndicatorType" minOccurs="1">
            <xs:annotation>
              <xs:documentation>Сведения о результатах рассмотрения Заключения: 0 - риски не подтвердились; 1 - риски подтвердились; 2 - риски подтвердились частично</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="NotConfirmedRisksGoods" type="pe_res:NotConfirmedRisksGoodsType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Сведения из Раздела 1 (о товарах, по которым лицом не подтверждены риски)</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ConfirmedRisksGoods" type="pe_res:ConfirmedRisksGoodsType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Сведения из Раздела 2 (о товарах, по которым лицом подтверждены риски)</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="AddInfo" type="clt_ru:FreeText250Type" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>Дополнительная информация лица по результатам рассмотрения Заключения</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="SigningPerson" type="cat_ru:PersonSignatureType" minOccurs="1">
            <xs:annotation>
              <xs:documentation>Сведения о лице, подписавшем документ</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Application1" type="pe_res:ApplicationType" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>Приложение №1 к Результатам</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Application2" type="pe_res:ApplicationType" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>Приложение №2 к Результатам</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
        <xs:attribute name="DocumentModeID" type="clt_ru:DocumentModeIDType" use="required" fixed="1006959E">
          <xs:annotation>
            <xs:documentation>Идентификатор вида документа</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:annotation>
    <xs:documentation>Локальные прикладные типы</xs:documentation>
  </xs:annotation>
  <xs:complexType name="ApplicationType">
    <xs:annotation>
      <xs:documentation>Приложение к Результатам</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="NumPP" type="clt_ru:Count8Type">
        <xs:annotation>
          <xs:documentation>Порядковый номер</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DTNum" type="cat_ru:GTDIDType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Номер ДТ</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="GoodsNumeric" type="clt_ru:Count5Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Номер товара в ДТ</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="GoodsDescription" type="clt_ru:FreeText250Type" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Пояснения по товару</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ConfirmDocType">
    <xs:annotation>
      <xs:documentation>Сведения о документах, подтверждающих наличие / отсутствие рисков</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="cat_ru:DocumentBaseType">
        <xs:sequence>
          <xs:element name="NumPP" type="clt_ru:Count8Type">
            <xs:annotation>
              <xs:documentation>Порядковый номер</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="DocCode" type="clt_ru:CustomsDocumentCodeType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Код документа в соответствии с классификатором видов документов и сведений</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="ConfirmedRisksGoodsType">
    <xs:annotation>
      <xs:documentation>Сведения из Раздела 2 (о товарах, по которым лицом подтверждены риски)</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="MeasuresDescription" type="clt_ru:FreeText250Type" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Описание мер, принятых лицом для подтверждения</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ConfirmDoc" type="pe_res:ConfirmDocType" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Сведения о документах, подтверждающих наличие рисков</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="DocConcNumberType">
    <xs:annotation>
      <xs:documentation>Номер Заключения</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="cat_ru:GTDIDType">
        <xs:sequence>
          <xs:element name="AddCode" type="clt_ru:Code3Type" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Указывается "210"</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="OperationCode" type="clt_ru:Code2Type" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Указывается "02"</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="DocResNumberType">
    <xs:annotation>
      <xs:documentation>Номер Результатов</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="pe_res:DocConcNumberType">
        <xs:sequence>
          <xs:element name="PositionNum" type="clt_ru:Code3Type" minOccurs="1">
            <xs:annotation>
              <xs:documentation>Текущая позиция на Заключение</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="NotConfirmedRisksGoodsType">
    <xs:annotation>
      <xs:documentation>Сведения из Раздела 1 (о товарах, по которым лицом не подтверждены риски)</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="ConfirmDoc" type="pe_res:ConfirmDocType" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Сведения о документах, подтверждающих отсутствие рисков</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Notes" type="clt_ru:FreeText250Type" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Пояснения (доводы) лица по вопросу отсутствия рисков (в целом по Разделу 1 Результатов)</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>